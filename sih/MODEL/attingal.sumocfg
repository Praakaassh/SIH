<configuration>
    <input>
        <net-file value="attingal.net.xml"/>
        <route-files value="attingal.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        </time>
    <processing>
        <collision.check-junctions value="true"/>
        <collision.action value="warn"/>
    </processing>
    <output>
        <summary-output value="simulation_summary.xml"/>
        <tripinfo-output value="tripinfo.xml"/>
    </output>
</configuration>